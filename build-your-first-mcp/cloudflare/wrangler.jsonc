{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop-data-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Create the database with: npx wrangler d1 create shop-data
  // then replace database_id below with the id it prints. Local dev works with any id.
  "d1_databases": [
    { "binding": "DB", "database_name": "shop-data", "database_id": "fd7e4702-4a5d-4a92-bbda-47e6e4c6f1d6" }
  ],
  // Workers Rate Limiting: 60 requests per minute per client IP. period must be 10 or 60 seconds.
  // namespace_id is any number you choose, unique within your account.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
