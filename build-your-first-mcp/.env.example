# Settings for `uv run shop-data`. Copy to .env and run: uv run --env-file .env shop-data
# Every value here is the default.

# The SQLite file. Empty means <this folder>/data/shop.db. Relative paths are made absolute.
SHOP_DB_PATH=

# stdio: a desktop app starts the server. http: serve http://HOST:PORT/mcp
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http. Use HOST=0.0.0.0 in a container.
HOST=127.0.0.1
PORT=8000

# false removes save_note, making the server read-only. Use false for anything public.
ALLOW_WRITES=true
