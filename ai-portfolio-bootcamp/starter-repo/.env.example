# Copy this file to .env and fill in your key.
# .env is gitignored. Never commit a real key.

ANTHROPIC_API_KEY=sk-ant-...

# Model to use. Leave as-is unless you have a reason to change it.
MODEL=claude-opus-5

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Below this confidence, the system flags the record for human review
# instead of trusting its own answer. Your brief should justify this number.
REVIEW_THRESHOLD=0.75
